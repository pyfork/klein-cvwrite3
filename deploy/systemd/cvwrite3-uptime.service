# One /healthz call on this box, one uptime_checks row. Run every minute by cvwrite3-uptime.timer.
[Unit]
Description=cvwrite3 uptime check

[Service]
Type=oneshot
User=cvwrite3
Group=cvwrite3
Slice=cvwrite3.slice
WorkingDirectory=/srv/cvwrite3/app
EnvironmentFile=/srv/cvwrite3/.env
LogNamespace=cvwrite3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/cvwrite3/data
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
UMask=0077
ExecStart=/srv/cvwrite3/venv/bin/python -m app.uptime
