# The worker: jobs from Postgres, up to 3 at once, one Chrome at a time (brief, Addendum 1).
# Chrome is the first thing the kernel kills if memory runs out (oom_score_adj=1000, set by the worker),
# and OOMPolicy=continue keeps the worker up when that happens. No PrivateDevices: Chrome needs /dev/shm.
[Unit]
Description=cvwrite3 worker
After=network.target postgresql.service cvwrite3-app.service
Wants=postgresql.service

[Service]
User=cvwrite3
Group=cvwrite3
Slice=cvwrite3.slice
WorkingDirectory=/sites/cvwrite3/app
EnvironmentFile=/sites/cvwrite3/.env
LogNamespace=cvwrite3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/sites/cvwrite3/data
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
UMask=0077
Environment=HOME=/sites/cvwrite3/data/chrome-home
ExecStart=/sites/cvwrite3/venv/bin/python -m app.worker
MemoryMax=550M
OOMPolicy=continue
Restart=always
RestartSec=2
KillSignal=SIGTERM
TimeoutStopSec=90

[Install]
WantedBy=multi-user.target
