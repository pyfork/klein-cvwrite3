# The web app: uvicorn on 127.0.0.1:8000 behind nginx and Cloudflare Access.
# Its own request log is one JSON line per request (journalctl --namespace=cvwrite3), so uvicorn's is off.
[Unit]
Description=cvwrite3 web app
After=network.target postgresql.service
Wants=postgresql.service

[Service]
User=cvwrite3
Group=cvwrite3
Slice=cvwrite3.slice
WorkingDirectory=/srv/cvwrite3/app
EnvironmentFile=/srv/cvwrite3/.env
LogNamespace=cvwrite3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/cvwrite3/data
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
UMask=0077
ExecStartPre=/srv/cvwrite3/venv/bin/python -m app.db migrate
ExecStart=/srv/cvwrite3/venv/bin/uvicorn app.main:create_app --factory --host 127.0.0.1 --port 8000 --workers 1 --no-access-log
MemoryMax=250M
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
