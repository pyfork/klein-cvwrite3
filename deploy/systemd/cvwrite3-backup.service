# The encrypted backup to cvwrite3's own Spaces bucket (does the work only when the last good copy is over 44 h old).
[Unit]
Description=cvwrite3 backup
After=postgresql.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=cvwrite3
Group=cvwrite3
Slice=cvwrite3.slice
WorkingDirectory=/srv/cvwrite3/app
EnvironmentFile=/srv/cvwrite3/.env
LogNamespace=cvwrite3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/cvwrite3/data
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
UMask=0077
ExecStart=/srv/cvwrite3/venv/bin/python -m app.backup
TimeoutStartSec=45min
MemoryMax=300M
