# cvwrite3 as one tenant: other tenants win when both want the CPU, and half a core always stays free.
# No swap: sk24 has a 4 GB swapfile, and swapping CVs to disk would slow every tenant before MemoryMax is hit.
[Unit]
Description=cvwrite3 (all units)

[Slice]
MemoryHigh=600M
MemoryMax=750M
MemorySwapMax=0
CPUWeight=50
CPUQuota=150%
