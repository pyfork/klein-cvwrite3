# cvwrite3 settings, a template with no values. On the server, copy to .env (0600); the owner types each secret into a hidden prompt.
CVWRITE_ENV=prod
CVWRITE_DATABASE_URL=postgresql:///cvwrite3?host=/var/run/postgresql
CVWRITE_OWNER_EMAIL=
CVWRITE_SECRET_KEY=
CVWRITE_ACCESS_TEAM=
CVWRITE_ACCESS_AUD=
CVWRITE_APP_ORIGIN=https://cvwrite3.puascari.com
# Optional; defaults to https://<team>/cdn-cgi/access/certs
CVWRITE_ACCESS_CERTS_URL=
