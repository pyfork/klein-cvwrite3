# cvwrite3 settings, a template with no values. On the server, copy to /srv/cvwrite3/.env (0600, owner cvwrite3).
# The owner types each secret into a hidden prompt (read -s); none of them ever goes in git, chat or a command line.

# --- the app ---
CVWRITE_ENV=prod
CVWRITE_DATABASE_URL=postgresql:///cvwrite3?host=/var/run/postgresql
CVWRITE_OWNER_EMAIL=
# secret: 32+ random characters (openssl rand -hex 32)
CVWRITE_SECRET_KEY=
# Cloudflare Access: the team domain (e.g. yourteam.cloudflareaccess.com) and the app's AUD tag
CVWRITE_ACCESS_TEAM=
CVWRITE_ACCESS_AUD=
CVWRITE_APP_ORIGIN=https://cvwrite3.puascari.com
# Optional; defaults to https://<team>/cdn-cgi/access/certs
CVWRITE_ACCESS_CERTS_URL=

# --- files outside git ---
CVWRITE_DATA_DIR=/srv/cvwrite3/data
CVWRITE_PROMPTS_DIR=/srv/cvwrite3/prompts
CVWRITE_QR_PATH=/srv/cvwrite3/config/qr/duitnow.png

# --- the render ---
CVWRITE_CHROME=/usr/bin/google-chrome
CVWRITE_CHROME_FLAGS=--disable-extensions --disable-background-networking --disable-component-update --disable-sync --disable-default-apps --mute-audio --renderer-process-limit=1 --disable-features=Translate,MediaRouter,OptimizationHints,AutofillServerCommunication --js-flags=--max-old-space-size=64

# --- Claude ---
# secret: the cvwrite3 workspace's API key
ANTHROPIC_API_KEY=

# --- the backup (python -m app.backup) ---
CVWRITE_BACKUP_ENDPOINT=https://sgp1.digitaloceanspaces.com
CVWRITE_BACKUP_BUCKET=
# the owner's age public key (age1...); the private key stays offline with the owner
CVWRITE_BACKUP_AGE_RECIPIENT=
# secret: a Spaces access key for cvwrite3's own bucket only
CVWRITE_BACKUP_KEY_ID=
CVWRITE_BACKUP_SECRET=
